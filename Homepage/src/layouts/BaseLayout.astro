---
import GalleryModal from '@/components/layout/GalleryModal.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import '@/styles/global.css';

type Props = {
  title?: string;
  description?: string;
  pageClass?: string;
  showHeader?: boolean;
};

const {
  title = 'AIM Replica',
  description = 'A local Astro reconstruction inspired by aim.obys.agency.',
  pageClass = '',
  showHeader = true
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body class={pageClass}>
    <div class="page-transition" data-page-transition></div>
    {showHeader && <SiteHeader />}
    <GalleryModal />
    <slot />

    <script>
      import Lenis from 'lenis';

      const body = document.body;
      const menuPanel = document.querySelector('[data-menu-panel]');
      const galleryModal = document.querySelector('[data-gallery-modal]');
      const transitionLayer = document.querySelector('[data-page-transition]');
      const revealItems = [...document.querySelectorAll('.reveal-line')];
      const isHome = body.classList.contains('page-home');

      const openMenu = () => {
        body.classList.add('menu-open');
        menuPanel?.setAttribute('aria-hidden', 'false');
      };

      const closeMenu = () => {
        body.classList.remove('menu-open');
        menuPanel?.setAttribute('aria-hidden', 'true');
      };

      const openGallery = () => {
        body.classList.add('gallery-open');
        galleryModal?.setAttribute('aria-hidden', 'false');
      };

      const closeGallery = () => {
        body.classList.remove('gallery-open');
        galleryModal?.setAttribute('aria-hidden', 'true');
      };

      document.querySelectorAll('[data-toggle-menu]').forEach((button) => {
        button.addEventListener('click', () => {
          if (body.classList.contains('menu-open')) {
            closeMenu();
          } else {
            openMenu();
          }
        });
      });

      document.querySelectorAll('[data-close-menu]').forEach((button) => {
        button.addEventListener('click', closeMenu);
      });

      document.querySelectorAll('[data-open-gallery]').forEach((button) => {
        button.addEventListener('click', openGallery);
      });

      document.querySelectorAll('[data-close-gallery]').forEach((button) => {
        button.addEventListener('click', closeGallery);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeMenu();
          closeGallery();
        }
      });

      document.querySelectorAll('a.transition-link').forEach((link) => {
        link.addEventListener('click', (event) => {
          const anchor = event.currentTarget;
          if (!(anchor instanceof HTMLAnchorElement)) return;
          const url = new URL(anchor.href, window.location.href);
          const isSameOrigin = url.origin === window.location.origin;
          if (!isSameOrigin || url.pathname === window.location.pathname) return;

          event.preventDefault();
          transitionLayer?.classList.add('is-active');
          setTimeout(() => {
            window.location.href = anchor.href;
          }, 450);
        });
      });

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({
          duration: 1.1,
          lerp: 0.09
        });

        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };

        requestAnimationFrame(raf);
      }

      if (isHome) {
        const syncHomeHeader = () => {
          const header = document.querySelector('.site-header');
          if (!(header instanceof HTMLElement)) return;
          const pinStart = parseFloat(getComputedStyle(document.body).getPropertyValue('--home-header-top')) || 384;
          body.classList.toggle('home-header-pinned', window.scrollY >= pinStart - 4);
        };

        syncHomeHeader();
        window.addEventListener('scroll', syncHomeHeader, { passive: true });
        window.addEventListener('resize', syncHomeHeader);
      }

      if (revealItems.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.25 }
        );

        revealItems.forEach((item, index) => {
          if (item instanceof HTMLElement) {
            item.style.setProperty('--delay', `${index * 90}ms`);
          }
          observer.observe(item);
        });
      }
    </script>
  </body>
</html>
