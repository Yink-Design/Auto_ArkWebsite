---
import { galleryItems } from '@/data/gallery';
---

<aside class="gallery-modal" data-gallery-modal aria-hidden="true">
  <div class="gallery-modal__backdrop" data-close-gallery></div>
  <div class="gallery-modal__panel">
    <div class="gallery-modal__sheet">
      <div class="gallery-modal__top">
        <div>
          <p class="eyebrow">Gallery</p>
          <h2>AI archival fragments</h2>
        </div>
        <button type="button" class="menu-close" data-close-gallery>[Close]</button>
      </div>

      <div class="gallery-modal__index">
        <p>Gallery:</p>
      </div>

      <div class="gallery-grid">
        {galleryItems.map((item) => (
          <figure class={`gallery-card gallery-card--${item.ratio ?? 'square'}`}>
            <div class="gallery-card__image">
              <img src={item.image} alt={item.caption} loading="lazy" />
            </div>
            <figcaption>
              <strong>{item.title}</strong>
              <span>{item.artist}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</aside>
