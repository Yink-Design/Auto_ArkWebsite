---
import AimWordmark from '@/components/home/AimWordmark.astro';
import HomeMotionLayer from '@/components/home/HomeMotionLayer';
import { modernists } from '@/data/site';
---

<section class="home-hero" id="Home-hero">
  <HomeMotionLayer client:load />
  <div class="home-hero__frame">
    <div class="home-hero__top" aria-hidden="true">
      <div class="home-hero__line home-hero__line--thin"></div>
      <div class="home-hero__band">
        <div class="home-hero__band-fill"></div>
      </div>
      <div class="home-hero__line home-hero__line--divider"></div>
    </div>

    <div class="home-hero__inner">
      <div class="home-hero__left">
        <div class="hero-index">
          <div class="hero-index__label">Modernists:</div>
          <div class="hero-index__list">
            {modernists.map((entry) => (
              <p>{entry.code}: {entry.name}</p>
            ))}
          </div>
        </div>
      </div>

      <div class="home-hero__right">
        <div class="home-hero__title">
          <div class="hero-cutoff"><h1>AIM-</h1></div>
          <div class="hero-cutoff"><h1>AI Modernism</h1></div>
          <div class="hero-cutoff"><h1>Of Kharkiv</h1></div>
        </div>

        <a href="#Home-about" class="home-hero__scroll">
          <span>Scroll to Explore</span>
          <span aria-hidden="true">&#8595;</span>
        </a>
      </div>
    </div>

    <div class="home-hero__line home-hero__line--bottom"></div>
    <div class="home-hero__wordmark" aria-hidden="true">
      <AimWordmark />
    </div>
  </div>
</section>
